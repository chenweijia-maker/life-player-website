.page {
  min-height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.view-back {
  margin-bottom: 20rpx;
}

.btn {
  border-radius: 999rpx;
  font-size: 26rpx;
}

.btn-outline {
  background: transparent;
  border: 2rpx solid rgba(102, 126, 234, 0.8);
  color: #667eea;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
}

.btn-mini {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
}

.feature-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: rgba(255, 255, 255, 0.95);
}

.feature-content {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

.empty-state {
  padding: 48rpx 24rpx;
  text-align: center;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 12rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.tip {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  padding: 40rpx;
}

.tip.error {
  color: #fca5a5;
}

.balance-row {
  font-size: 26rpx;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.list-item.done .list-item-title {
  text-decoration: line-through;
  opacity: 0.7;
}

.list-item-main {
  flex: 1;
  min-width: 0;
}

.list-item-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.list-item-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  margin: 24rpx 0 12rpx;
  color: rgba(255, 255, 255, 0.95);
}

.section-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 16rpx;
}

.form-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.input-inline {
  flex: 1;
  min-width: 120rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  font-size: 26rpx;
  color: #333;
  background: rgba(255, 255, 255, 0.9);
}

.input-inline.input-amount {
  flex: 0 0 160rpx;
}

.input-block {
  width: 100%;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  font-size: 26rpx;
  color: #333;
  background: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.textarea-block {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  font-size: 26rpx;
  color: #333;
  background: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.btn-inline {
  flex-shrink: 0;
}

.picker-inline {
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #333;
}

.finance-card {
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.08);
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.finance-meta {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.progress-bar {
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.2);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  transition: width 0.2s ease;
}
