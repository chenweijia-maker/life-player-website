page {
  height: 100%;
  background-color: #667eea; /* 备用背景色 */
}

.page {
  position: relative;
  min-height: 100%;
  padding: 16rpx 14rpx;
  box-sizing: border-box;
}

.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  object-fit: cover;
}

.container {
  max-width: 480rpx;
  margin: 0 auto;
}

.title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.subtitle {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 18rpx;
}

.auth-card {
  border-radius: 18rpx;
  padding: 20rpx 18rpx 24rpx;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(24rpx);
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.35);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.intro {
  font-size: 20rpx;
  color: #475569;
  margin-bottom: 18rpx;
  line-height: 1.45;
}

.agreements {
  margin-bottom: 14rpx;
}

.agree-row {
  display: flex;
  align-items: flex-start;
}

.agree-row checkbox {
  margin-right: 8rpx;
  transform: scale(0.85);
}

.agree-text {
  font-size: 20rpx;
  color: #4b5563;
  line-height: 1.5;
}

.link {
  color: #4f46e5;
}

.btn {
  border-radius: 999rpx;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
}

.main-btn {
  width: 100%;
  margin-top: 6rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

.btn-outline {
  margin-top: 12rpx;
  width: 100%;
  background: transparent;
  border: 1rpx solid rgba(148, 163, 184, 0.9);
  color: #4b5563;
}

.msg {
  margin-top: 12rpx;
  font-size: 20rpx;
}

.msg-error {
  color: #dc2626;
}

.msg-hint {
  color: #16a34a;
}

.audit-note {
  margin-top: 14rpx;
  font-size: 18rpx;
  color: #94a3b8;
  line-height: 1.35;
}

