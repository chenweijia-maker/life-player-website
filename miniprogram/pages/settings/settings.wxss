.page {
  min-height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  max-width: 560rpx;
  margin: 80rpx auto 0;
  padding: 40rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.menu {
  margin-bottom: 32rpx;
}

.menu-btn {
  display: block;
  width: 100%;
  padding: 24rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: none;
}

.menu-btn.logout {
  background: rgba(239, 68, 68, 0.25);
  color: #fca5a5;
}

.back-btn {
  width: 240rpx;
  margin: 0 auto;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
}
